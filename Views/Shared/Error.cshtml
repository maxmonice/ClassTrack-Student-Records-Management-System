@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<h1 class="page-title">Something went wrong</h1>
<p class="text-muted">An error occurred while processing your request.</p>

@if (Model.ShowRequestId)
{
    <p><strong>Request ID:</strong> <code>@Model.RequestId</code></p>
}

<a asp-controller="Student" asp-action="Index" class="btn btn-primary">Back to students</a>
